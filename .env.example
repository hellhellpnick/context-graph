# ── LLM Provider API Keys ──────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (if using provider=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (if using OpenAI-compatible)
# DEEPSEEK_API_KEY=sk-...

# Together AI
# TOGETHER_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# ── Context Graph Configuration (optional, overrides .context-graph.json) ──

# Provider: openai | anthropic | openai-compat
# CONTEXT_GRAPH_PROVIDER=openai

# Model name (depends on provider)
# CONTEXT_GRAPH_MODEL=gpt-4o

# Base URL (for OpenAI-compatible providers)
# CONTEXT_GRAPH_BASE_URL=http://localhost:11434/v1
# CONTEXT_GRAPH_BASE_URL=https://api.deepseek.com/v1
# CONTEXT_GRAPH_BASE_URL=https://api.together.xyz/v1

# Scanning limits
# CONTEXT_GRAPH_MAX_FILES=200
# CONTEXT_GRAPH_MAX_INPUT_TOKENS=80000

