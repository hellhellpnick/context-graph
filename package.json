{
	"name": "context-graph",
	"version": "0.1.0",
	"description": "Auto-generate AI context graphs for any codebase. One command, zero config.",
	"bin": {
		"context-graph": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/",
		"prompts/"
	],
	"scripts": {
		"build": "node -e \"const fs=require('fs');fs.mkdirSync('prompts',{recursive:true});fs.copyFileSync('graph-create-agent.md','prompts/graph-create-agent.md')\" && tsc",
		"dev": "ts-node src/cli.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"context-graph": "node dist/cli.js",
		"graph:build": "node dist/cli.js build",
		"graph:actualize": "node dist/cli.js actualize",
		"graph:validate": "node dist/cli.js validate",
		"graph:agents": "node dist/cli.js agents"
	},
	"keywords": [
		"context-graph",
		"copilot",
		"ai",
		"code-analysis",
		"llm",
		"github-copilot"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.39.0",
		"chalk": "^4.1.2",
		"commander": "^12.1.0",
		"dotenv": "^16.4.0",
		"enquirer": "^2.4.1",
		"glob": "^10.4.0",
		"ignore": "^5.3.0",
		"openai": "^4.77.0",
		"ora": "^5.4.1"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.0"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
